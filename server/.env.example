# Copy this file to .env and fill in values before running the server.

# Optional. If not set, the app uses a temporary in-memory database
# (great for trying things out, but data is lost when the server restarts).
# For real, persistent storage, create a free cluster at https://www.mongodb.com/cloud/atlas
# and paste its connection string here.
MONGODB_URI=

# Any long random string. Used to sign login session cookies.
SESSION_SECRET=change-this-to-a-long-random-string

# Port the API server listens on.
PORT=4000

# The URL of your deployed frontend, for CORS. Leave blank during local development.
CLIENT_ORIGIN=
